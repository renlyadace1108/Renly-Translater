<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>RenlyTranslater</AssemblyName>
    <Product>Renly Translater</Product>
    <AssemblyTitle>Renly Translater</AssemblyTitle>
    <Description>Renly Translater - 面向英语四六级与雅思备考的双语对照翻译与长难句精读桌面端软件</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExamBilingualReader.Core\ExamBilingualReader.Core.csproj" />
    <ProjectReference Include="..\ExamBilingualReader.Infrastructure\ExamBilingualReader.Infrastructure.csproj" />
  </ItemGroup>

</Project>
