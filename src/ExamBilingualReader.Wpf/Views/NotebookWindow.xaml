<Window x:Class="ExamBilingualReader.Wpf.Views.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生词本与真题语境复习" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="我的备考生词本" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导出为 CSV" Click="OnExportCsvClick" Background="#10B981" Margin="0,0,10,0"/>
                <Button Content="刷新" Click="OnRefreshClick" Background="#374151"/>
            </StackPanel>
        </DockPanel>

        <!-- 生词数据表格 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="{StaticResource CardBackgroundBrush}" RowBackground="#1F2937" AlternatingRowBackground="#283548"
                  Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#374151" BorderBrush="#374151">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单词" Binding="{Binding Word}" FontWeight="Bold" Width="120"/>
                <DataGridTextColumn Header="音标" Binding="{Binding Phonetic}" Width="100"/>
                <DataGridTextColumn Header="考纲等级" Binding="{Binding LevelTag}" Width="80"/>
                <DataGridTextColumn Header="中文释义" Binding="{Binding Translation}" Width="200"/>
                <DataGridTextColumn Header="摘录语境例句" Binding="{Binding ContextSentence}" Width="*" />
                <DataGridTextColumn Header="收藏时间" Binding="{Binding AddedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Background="#EF4444" Padding="6,2" FontSize="11"
                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部状态栏 -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" FontSize="12"/>
    </Grid>
</Window>
