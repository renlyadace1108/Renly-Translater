<Window x:Class="ExamBilingualReader.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamBilingualReader.Wpf.Views"
        Title="系统偏好设置" Height="650" Width="680"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="#121316">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部精简标签切换器 (高对比度双 Tab) -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="#181A20" CornerRadius="6" Padding="3" BorderBrush="#2C2F36" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Content="🤖 AI 模型与 API 密钥" GroupName="SettingsTabGroup"
                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                             Click="OnTabModelClick"
                             Style="{StaticResource {x:Type ToggleButton}}" Background="#252834" Foreground="#ECEEF2"
                             Padding="0,8" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
                <RadioButton Grid.Column="1" Content="🎨 阅读排版与外观主题" GroupName="SettingsTabGroup"
                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                             Click="OnTabThemeClick"
                             Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#8E95A3"
                             Padding="0,8" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ==================== TAB 0: AI 模型与 API 密钥 ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0}">
            <StackPanel Margin="0,4,0,0">
                <!-- 模型名称与一键预设 -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="模型名称 (Model Name):" Foreground="#8E95A3" FontSize="12.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="快捷填入:" Foreground="#5A606E" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="DeepSeek-V3" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-DeepSeek-V3" 
                                Padding="8,3" FontSize="11" Margin="0,0,4,0" Background="#22252E" ToolTip="推荐：SiliconFlow 深度求索 V3，句法与长难句拆解极强"/>
                        <Button Content="Qwen-72B" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-72B" 
                                Padding="8,3" FontSize="11" Margin="0,0,4,0" Background="#22252E" ToolTip="SiliconFlow 通义千问 72B 旗舰版"/>
                        <Button Content="DeepSeek官方" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeek-Official" 
                                Padding="8,3" FontSize="11" Margin="0,0,4,0" Background="#22252E" ToolTip="DeepSeek 官方开放平台 deepseek-chat"/>
                        <Button Content="Qwen-7B免费" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-7B-Free" 
                                Padding="8,3" FontSize="11" Background="#22252E" ToolTip="SiliconFlow 永久免费版 7B"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding SelectedProvider.ModelName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" Background="#1E2025" Foreground="#ECEEF2" BorderBrush="#2C2F36" Margin="0,0,0,16"/>

                <!-- 接口地址 (Base URL) -->
                <TextBlock Text="接口地址 (Base URL):" Margin="0,0,0,6" Foreground="#8E95A3" FontSize="12.5"/>
                <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" Background="#1E2025" Foreground="#ECEEF2" BorderBrush="#2C2F36" Margin="0,0,0,16"/>

                <!-- API Key -->
                <TextBlock Text="API Key:" Margin="0,0,0,6" Foreground="#8E95A3" FontSize="12.5"/>
                <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" Background="#1E2025" Foreground="#ECEEF2" BorderBrush="#2C2F36" Margin="0,0,0,8"/>

                <TextBlock Text="💡 提示：支持任意 OpenAI 兼容标准接口。推荐使用 DeepSeek-V3 获得最佳句法分析效果。" 
                           Foreground="#5A606E" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== TAB 1: 阅读排版与外观主题 ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=1}">
            <StackPanel Margin="0,2,0,0">
                <!-- 1. 一键主题配色预设卡片 -->
                <Border Background="#181A20" BorderBrush="#2C2F36" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="一键主题配色 (整体套用专业阅读风格):" Foreground="#8E95A3" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Rows="2">
                            <Button Content="🌌 莫兰迪暗夜 (默认)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="DarkMorandi" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                            <Button Content="⬛ 极客纯黑 (OLED)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="PureBlack" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                            <Button Content="📜 羊皮纸暖阳" Command="{Binding ApplyThemePresetCommand}" CommandParameter="WarmPaper" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                            <Button Content="🌲 森林绿意 (护眼)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="SageGreen" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                            <Button Content="❄️ 极地灰蓝 (Nord)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="NordDracula" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                            <Button Content="📄 墨水白 (高对比)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="CleanWhite" Margin="3" Padding="8,6" Background="#22252E" FontSize="12"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. 字体与字号排版卡片 -->
                <Border Background="#181A20" BorderBrush="#2C2F36" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- 字体大小与粗细 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 字号滑块与微调按钮 -->
                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="阅读字号:" Foreground="#8E95A3" FontSize="12.5" VerticalAlignment="Center"/>
                                    <Border Background="#212A3D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ReaderStyle.FontSize, StringFormat='{}{0:0} px'}" 
                                                   Foreground="#61AFEF" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="-" Command="{Binding DecreaseFontSizeCommand}" Padding="0,2" Background="#252834" ToolTip="缩小字号"/>
                                    <Slider Grid.Column="1" Minimum="12" Maximum="32" SmallChange="1" LargeChange="2" 
                                            Value="{Binding ReaderStyle.FontSize, Mode=TwoWay}" Margin="8,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="+" Command="{Binding IncreaseFontSizeCommand}" Padding="0,2" Background="#252834" ToolTip="放大字号"/>
                                </Grid>
                            </StackPanel>

                            <!-- 字体粗细分段按钮 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="字体粗细 (Font Weight):" Foreground="#8E95A3" FontSize="12.5" Margin="0,0,0,6"/>
                                <UniformGrid Columns="4">
                                    <Button Content="常规" Command="{Binding ApplyFontWeightCommand}" CommandParameter="Normal" Margin="2,0" Padding="0,4" Background="#22252E" FontSize="11.5"/>
                                    <Button Content="适中" Command="{Binding ApplyFontWeightCommand}" CommandParameter="Medium" Margin="2,0" Padding="0,4" Background="#22252E" FontSize="11.5"/>
                                    <Button Content="半粗" Command="{Binding ApplyFontWeightCommand}" CommandParameter="SemiBold" Margin="2,0" Padding="0,4" Background="#22252E" FontSize="11.5"/>
                                    <Button Content="加粗" Command="{Binding ApplyFontWeightCommand}" CommandParameter="Bold" Margin="2,0" Padding="0,4" Background="#22252E" FontSize="11.5"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <!-- 字体族 (Font Family) -->
                        <TextBlock Text="字体族 (Font Family):" Foreground="#8E95A3" FontSize="12.5" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="默认优雅" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Segoe UI, Microsoft YaHei, Calibri" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                            <Button Content="微软雅黑" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Microsoft YaHei" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                            <Button Content="Georgia 衬线" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Georgia" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                            <Button Content="Times New Roman" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Times New Roman" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                            <Button Content="Calibri 简明" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Calibri" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                            <Button Content="Cascadia 等宽" Command="{Binding ApplyFontFamilyCommand}" CommandParameter="Cascadia Code, Consolas" Margin="0,0,5,5" Padding="7,2" Background="#22252E" FontSize="11"/>
                        </WrapPanel>
                        <TextBox Text="{Binding ReaderStyle.FontFamily, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,6" FontSize="12.5" Background="#1E2025" Foreground="#ECEEF2" BorderBrush="#2C2F36"/>
                    </StackPanel>
                </Border>

                <!-- 3. 颜色自定义卡片 -->
                <Border Background="#181A20" BorderBrush="#2C2F36" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="界面与排版颜色 (实时预览):" Foreground="#8E95A3" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 文字颜色 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="文字颜色:" Foreground="#8E95A3" FontSize="12" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding ReaderStyle.TextColor, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                            CornerRadius="3" BorderBrush="#3A3E4A" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ReaderStyle.TextColor, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" Background="#1E2025" Foreground="#ECEEF2"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="纯白" Command="{Binding ApplyTextColorCommand}" CommandParameter="#FFFFFF" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="浅灰" Command="{Binding ApplyTextColorCommand}" CommandParameter="#ECEEF2" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="深褐" Command="{Binding ApplyTextColorCommand}" CommandParameter="#2C2623" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="浅绿" Command="{Binding ApplyTextColorCommand}" CommandParameter="#D8EED8" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 阅读背景色 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="阅读背景色:" Foreground="#8E95A3" FontSize="12" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding ReaderStyle.ReadingBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                            CornerRadius="3" BorderBrush="#3A3E4A" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ReaderStyle.ReadingBackground, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" Background="#1E2025" Foreground="#ECEEF2"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="暗夜" Command="{Binding ApplyReadingBgCommand}" CommandParameter="#121316" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="纯黑" Command="{Binding ApplyReadingBgCommand}" CommandParameter="#000000" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="暖纸" Command="{Binding ApplyReadingBgCommand}" CommandParameter="#F6F1E5" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="素白" Command="{Binding ApplyReadingBgCommand}" CommandParameter="#F5F6F9" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 页面/卡片底色 -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="页面/卡片底色:" Foreground="#8E95A3" FontSize="12" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding ReaderStyle.PageBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                            CornerRadius="3" BorderBrush="#3A3E4A" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ReaderStyle.PageBackground, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" Background="#1E2025" Foreground="#ECEEF2"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="深灰" Command="{Binding ApplyPageBgCommand}" CommandParameter="#1E2025" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="曜石" Command="{Binding ApplyPageBgCommand}" CommandParameter="#121212" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="暖米" Command="{Binding ApplyPageBgCommand}" CommandParameter="#EDE6D6" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                    <Button Content="纯白" Command="{Binding ApplyPageBgCommand}" CommandParameter="#FFFFFF" Padding="5,1" Margin="0,0,3,3" FontSize="10" Background="#252834"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. 实时渲染预览视窗 -->
                <TextBlock Text="实时渲染预览视窗 (所见即所得):" Foreground="#8E95A3" FontSize="12" Margin="0,2,0,4"/>
                <Border Background="{Binding ReaderStyle.ReadingBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                        BorderBrush="#2C2F36" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Border Background="{Binding ReaderStyle.PageBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                            BorderBrush="#3E4452" BorderThickness="1" CornerRadius="5" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Renly Translater - 沉浸式学术精读预览效果" 
                                       FontSize="11" Foreground="#5A606E" Margin="0,0,0,4"/>
                            <TextBlock Text="The phenomenon of cognitive fatigue is ubiquitous, but proper strategies can mitigate its impact." 
                                       FontSize="{Binding ReaderStyle.FontSize}"
                                       FontFamily="{Binding ReaderStyle.FontFamily}"
                                       FontWeight="{Binding ReaderStyle.FontWeight}"
                                       Foreground="{Binding ReaderStyle.TextColor, Converter={x:Static local:HexToBrushConverter.Instance}}"
                                       TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 连通性测试状态输出 -->
        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" Foreground="#FBBF24" Margin="0,8,0,8" TextWrapping="Wrap" FontSize="12" MinHeight="18"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连通性" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" 
                    Background="#2A2D35" Padding="16,6" FontSize="13"
                    Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0}"/>
            <Button Content="保存并应用" Command="{Binding SaveSettingsCommand}" 
                    Background="#10B981" Padding="20,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
