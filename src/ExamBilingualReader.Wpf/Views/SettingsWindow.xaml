<Window x:Class="ExamBilingualReader.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模型服务配置" Height="460" Width="560"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与模型徽章 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AI 句法精读模型配置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Background="#1C261A" BorderBrush="#2F4F28" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                    <TextBlock Text="已锁定: SiliconFlow (硅基流动)" Foreground="#98C379" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <TextBlock Text="模型: Qwen/Qwen2.5-7B-Instruct (永久免费)" Foreground="#38BDF8" FontSize="11.5"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 配置表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API Key 输入框 -->
                <TextBlock Text="SiliconFlow API Key (密钥):" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8,7" FontSize="13" Margin="0,0,0,8" ToolTip="以 sk- 开头的密钥"/>
                <TextBlock Text="* 新账号免费赠送额度，且此 Qwen2.5-7B 官方永久免费调用，不消耗任何代金券。" 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,16"/>

                <!-- 预设参数卡片 (只读/半透明展示) -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="接口端点:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProvider.BaseUrl}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="调用模型:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProvider.ModelName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- 代理设置面板 (可选折叠) -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
                    <StackPanel>
                        <CheckBox Content="开启网络代理 (国内网络直连硅基流动通常无需开启)" IsChecked="{Binding SelectedProvider.Proxy.Enabled}" 
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                        <Grid IsEnabled="{Binding SelectedProvider.Proxy.Enabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedProvider.Proxy.Host}" ToolTip="代理主机 (如 127.0.0.1)" Padding="6,4" FontSize="12"/>
                            <TextBox Grid.Column="2" Text="{Binding SelectedProvider.Proxy.Port}" ToolTip="端口 (如 7890)" Padding="6,4" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 连通性测试状态输出 -->
        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" Foreground="#FBBF24" Margin="0,10,0,10" TextWrapping="Wrap" FontSize="12"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连通性" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" 
                    Background="#374151" Padding="16,6" FontSize="13"/>
            <Button Content="保存并应用" Command="{Binding SaveSettingsCommand}" 
                    Background="#10B981" Padding="18,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
