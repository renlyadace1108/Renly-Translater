<Window x:Class="ExamBilingualReader.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamBilingualReader.Wpf.Views"
        Title="系统设置" Height="580" Width="660"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标签切换器 -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="#181A20" CornerRadius="6" Padding="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Content="🤖 AI 模型与 API 密钥" GroupName="SettingsTabGroup"
                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0, Mode=OneWay}"
                             Click="OnTabModelClick"
                             Style="{StaticResource {x:Type ToggleButton}}" Background="#252834" Foreground="#ECEEF2"
                             Padding="0,7" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
                <RadioButton Grid.Column="1" Content="🎨 阅读排版与外观主题" GroupName="SettingsTabGroup"
                             IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=1, Mode=OneWay}"
                             Click="OnTabThemeClick"
                             Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#8E95A3"
                             Padding="0,7" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <!-- TAB 0: AI 模型与 API 配置 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0}">
            <StackPanel Margin="0,4,0,0">
                <!-- 模型名称与一键预设 -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="模型名称 (Model Name):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="快捷填入:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="DeepSeek-V3" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-DeepSeek-V3" 
                                Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="推荐：SiliconFlow 深度求索 V3，长难句拆解极强"/>
                        <Button Content="Qwen-72B" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-72B" 
                                Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="SiliconFlow 通义千问 72B 高性能旗舰版"/>
                        <Button Content="DeepSeek官方" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeek-Official" 
                                Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="DeepSeek 官方开放平台 deepseek-chat"/>
                        <Button Content="Qwen-7B免费" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-7B-Free" 
                                Padding="7,2" FontSize="11" Background="#262A36" ToolTip="SiliconFlow 永久免费版 7B"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding SelectedProvider.ModelName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                <!-- 接口地址 (Base URL) -->
                <TextBlock Text="接口地址 (Base URL):" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                <!-- API Key -->
                <TextBlock Text="API Key:" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                <TextBlock Text="提示：支持任意 OpenAI 兼容标准接口。推荐使用 DeepSeek-V3 获得最佳句法分析效果。" 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- TAB 1: 阅读排版与外观主题 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=1}">
            <StackPanel Margin="0,2,0,0">
                <!-- 预设主题风格胶囊 -->
                <TextBlock Text="一键主题配色:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,14">
                    <Button Content="🌌 莫兰迪暗夜" Command="{Binding ApplyThemePresetCommand}" CommandParameter="DarkMorandi" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                    <Button Content="⬛ 极客纯黑 (OLED)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="PureBlack" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                    <Button Content="📜 羊皮纸暖阳" Command="{Binding ApplyThemePresetCommand}" CommandParameter="WarmPaper" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                    <Button Content="🌲 森林绿意 (护眼)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="SageGreen" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                    <Button Content="❄️ 极地灰蓝 (Nord)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="NordDracula" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                    <Button Content="📄 墨水白 (高对比)" Command="{Binding ApplyThemePresetCommand}" CommandParameter="CleanWhite" Margin="0,0,6,6" Padding="9,3" Background="#232630" FontSize="11.5"/>
                </WrapPanel>

                <!-- 字体大小与字体族 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 字体大小 -->
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="阅读字体大小:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Text="{Binding ReaderStyle.FontSize, StringFormat='{}{0:0} px'}" 
                                       Foreground="#61AFEF" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12.5"/>
                        </DockPanel>
                        <Slider Minimum="12" Maximum="32" SmallChange="1" LargeChange="2" 
                                Value="{Binding ReaderStyle.FontSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 字体粗细 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="字体粗细 (Font Weight):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableFontWeights}" SelectedItem="{Binding ReaderStyle.FontWeight}"
                                  Padding="8,5" Background="{StaticResource CardBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 字体族 (Font Family) -->
                <TextBlock Text="字体族 (Font Family):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding AvailableFontFamilies}" Text="{Binding ReaderStyle.FontFamily, UpdateSourceTrigger=PropertyChanged}" 
                          IsEditable="True" Padding="8,5" Background="{StaticResource CardBackgroundBrush}" 
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                <!-- 颜色自定义区 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 字体颜色 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="文字颜色:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ReaderStyle.TextColor, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                    CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReaderStyle.TextColor, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <!-- 阅读区背景色 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="阅读背景色:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ReaderStyle.ReadingBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                    CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReaderStyle.ReadingBackground, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <!-- 页面/卡片底色 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="页面/卡片底色:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ReaderStyle.PageBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                    CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="26" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReaderStyle.PageBackground, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 实时渲染预览视窗 -->
                <TextBlock Text="实时渲染预览效果:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,4"/>
                <Border Background="{Binding ReaderStyle.ReadingBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Border Background="{Binding ReaderStyle.PageBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                            BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Renly Translater - 沉浸式学术精读预览" 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="The phenomenon of cognitive fatigue is ubiquitous, but proper strategies can mitigate its impact." 
                                       FontSize="{Binding ReaderStyle.FontSize}"
                                       FontFamily="{Binding ReaderStyle.FontFamily}"
                                       FontWeight="{Binding ReaderStyle.FontWeight}"
                                       Foreground="{Binding ReaderStyle.TextColor, Converter={x:Static local:HexToBrushConverter.Instance}}"
                                       TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 连通性测试状态输出 -->
        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" Foreground="#FBBF24" Margin="0,8,0,8" TextWrapping="Wrap" FontSize="12" MinHeight="18"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连通性" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" 
                    Background="#2A2D35" Padding="16,6" FontSize="13"
                    Visibility="{Binding SelectedTabIndex, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=0}"/>
            <Button Content="保存并应用" Command="{Binding SaveSettingsCommand}" 
                    Background="#10B981" Padding="20,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
