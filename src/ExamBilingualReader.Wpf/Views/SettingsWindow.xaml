<Window x:Class="ExamBilingualReader.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义模型与 API 配置" Height="450" Width="580"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="自定义模型与 API 配置" FontSize="17" FontWeight="SemiBold" 
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

        <!-- 配置表单区 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- 模型名称与一键预设 -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="模型名称 (Model Name):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="快捷填入:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="DeepSeek-V3" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-DeepSeek-V3" 
                            Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="推荐：SiliconFlow 深度求索 V3，句法与长难句拆解极强"/>
                    <Button Content="Qwen-72B" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-72B" 
                            Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="SiliconFlow 通义千问 72B 高性能旗舰版"/>
                    <Button Content="DeepSeek官方" Command="{Binding ApplyPresetCommand}" CommandParameter="DeepSeek-Official" 
                            Padding="7,2" FontSize="11" Margin="0,0,4,0" Background="#262A36" ToolTip="DeepSeek 官方开放平台 deepseek-chat"/>
                    <Button Content="Qwen-7B免费" Command="{Binding ApplyPresetCommand}" CommandParameter="SiliconFlow-Qwen-7B-Free" 
                            Padding="7,2" FontSize="11" Background="#262A36" ToolTip="SiliconFlow 永久免费版 7B"/>
                </StackPanel>
            </DockPanel>
            <TextBox Text="{Binding SelectedProvider.ModelName, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

            <!-- 接口地址 (Base URL) -->
            <TextBlock Text="接口地址 (Base URL):" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

            <!-- API Key -->
            <TextBlock Text="API Key:" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="10,7" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
        </StackPanel>

        <!-- 连通性测试状态输出 -->
        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" Foreground="#FBBF24" Margin="0,8,0,10" TextWrapping="Wrap" FontSize="12" MinHeight="18"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连通性" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" 
                    Background="#2A2D35" Padding="16,6" FontSize="13"/>
            <Button Content="保存并应用" Command="{Binding SaveSettingsCommand}" 
                    Background="#10B981" Padding="18,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
