<Window x:Class="ExamBilingualReader.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API 密钥配置" Height="250" Width="520"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="API Key 配置" FontSize="17" FontWeight="SemiBold" 
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- 仅展示 API Key 填写口 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="API Key:" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
            <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="10,8" FontSize="13" Background="{StaticResource CardBackgroundBrush}" 
                     Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
        </StackPanel>

        <!-- 连通性测试状态输出 -->
        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" Foreground="#FBBF24" Margin="0,10,0,12" TextWrapping="Wrap" FontSize="12"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连通性" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" 
                    Background="#2A2D35" Padding="16,6" FontSize="13"/>
            <Button Content="保存并应用" Command="{Binding SaveSettingsCommand}" 
                    Background="#10B981" Padding="18,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
