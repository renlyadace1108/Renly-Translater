<Window x:Class="ExamBilingualReader.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamBilingualReader.Wpf.Views"
        Title="Renly Translater" Height="820" Width="1360"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶部精简导航栏 (去掉繁琐Logo，采用高质感扁平标签设计) -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <!-- 左侧工作专区胶囊切换器与高分辨率彩色Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="26" Height="26" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Renly Translater" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#121316" CornerRadius="6" Padding="2" Margin="0,0,20,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="四六级备考" GroupName="ZoneGroup" IsChecked="True"
                                         Click="OnExamZoneClick"
                                         Style="{StaticResource {x:Type ToggleButton}}" Background="#252730" Foreground="#ECEEF2"
                                         Padding="14,5" BorderThickness="0" Cursor="Hand" FontSize="12.5" FontWeight="Medium"/>
                            <RadioButton Content="学术外刊阅读" GroupName="ZoneGroup"
                                         Click="OnGeneralArticleZoneClick"
                                         Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#8E95A3"
                                         Padding="14,5" BorderThickness="0" Cursor="Hand" FontSize="12.5" FontWeight="Medium" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 统一风格的极简功能操作按钮 -->
                    <Button Content="{Binding IsExamDrawerOpen, Converter={x:Static local:DrawerToggleTextConverter.Instance}}" 
                            Command="{Binding ToggleExamDrawerCommand}" Margin="0,0,8,0"
                            ToolTip="展开或收回左侧真题列表抽屉，让阅读区获得更大视野"
                            Visibility="{Binding CurrentZone, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=ExamPreparation}"/>
                    <Button Content="{Binding LayoutMode, Converter={x:Static local:LayoutModeToButtonTextConverter.Instance}}" 
                            Command="{Binding ToggleLayoutModeCommand}" Margin="0,0,8,0"
                            ToolTip="在「全文沉浸拖选」、「自然段落精读」与「逐句卡片对照」之间无缝切换"/>
                    <Button Content="导入文档 (PDF/MD)" Click="OnImportArticleClick" Margin="0,0,8,0"/>
                    <Button Content="全篇对照翻译" Command="{Binding TranslateAllSentencesCommand}" Margin="0,0,8,0"/>
                    <Button Content="生词本" Click="OnOpenNotebookClick" Margin="0,0,8,0"/>
                    <Button Content="🎨 排版外观" Click="OnOpenStyleSettingsClick" Margin="0,0,8,0" ToolTip="自定义阅读字体、字号、粗细及页面背景颜色"/>
                    <Button Content="模型设置" Click="OnOpenSettingsClick"/>
                </StackPanel>
                
                <!-- 右侧极简考纲色块图例（微圆角扁平胶囊） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="考纲标注" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11.5"/>
                    <Border Background="#1C261A" BorderBrush="#2F4F28" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                        <TextBlock Text="CET-4" Foreground="#98C379" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#2A2415" BorderBrush="#54441F" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                        <TextBlock Text="CET-6" Foreground="#E5C07B" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#2B191B" BorderBrush="#5C2B30" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="雅思 / 托福" Foreground="#E06C75" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容区域：[真题抽屉] + [双栏对照精读区] + [长难句结构解析侧边栏] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 四六级真题备考专用侧边栏 -->
                <ColumnDefinition Width="Auto" />
                <!-- 双语对照主阅读区 -->
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3" />
                <!-- 长难句学术解析侧边栏 -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 四六级备考专区：真题列表面板 (支持自由展开/收回，让主阅读区视野最大化) -->
            <Border Grid.Column="0" Width="260" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Visibility>
                    <MultiBinding Converter="{x:Static local:MultiBooleanToVisibilityConverter.Instance}">
                        <Binding Path="CurrentZone"/>
                        <Binding Path="IsExamDrawerOpen"/>
                    </MultiBinding>
                </Border.Visibility>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="真题题库 (GitHub)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>

                    <!-- 紧凑分类切换器 -->
                    <Border Grid.Row="1" Background="#121316" CornerRadius="5" Padding="2" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="全部" Command="{Binding FilterExamCategoryCommand}" CommandParameter="ALL" 
                                    Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11.5"/>
                            <Button Grid.Column="1" Content="CET-4" Command="{Binding FilterExamCategoryCommand}" CommandParameter="CET4" 
                                    Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11.5"/>
                            <Button Grid.Column="2" Content="CET-6" Command="{Binding FilterExamCategoryCommand}" CommandParameter="CET6" 
                                    Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11.5"/>
                        </Grid>
                    </Border>

                    <!-- 真题条目列表 (隐藏滚动条，支持鼠标平滑滚动) -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding ExamPapers}" SelectedItem="{Binding SelectedExamPaper}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnExamPaperSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Background="{StaticResource CardBackgroundBrush}" 
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#252730" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#A1A6B3" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding YearMonth}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 中央主阅读区：包含三种排版视图 (背景支持自定义) -->
            <Grid Grid.Column="1" Background="{Binding ReaderStyle.ReadingBackground, Converter={x:Static local:HexToBrushConverter.Instance}}">
                <!-- 视图 0：原文整块连贯沉浸展示 (全文连贯完整呈现，支持按住鼠标左键任意自由拖选长句/短语，松开后右侧自动同步并可一键 AI 精读拆解) -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding LayoutMode, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=FullArticleContinuous}">
                    <Border Margin="28,14" Padding="26,22" 
                            Background="{Binding ReaderStyle.PageBackground, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <!-- 顶部提示横条 -->
                            <Border Background="#181B22" BorderBrush="#252A36" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="💡 提示：按住鼠标左键在下方自由拖拽框选任意长难句或短语，松开后将自动触发 AI 参考翻译与句法结构精读分析。" 
                                               Foreground="#8F98A8" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- 原文整块展示与划词选择框 (字号、字体、粗细、颜色均响应 ReaderStyle 自定义) -->
                            <TextBox x:Name="FullArticleTextBox"
                                     Text="{Binding ArticleInput, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     Foreground="{Binding ReaderStyle.TextColor, Converter={x:Static local:HexToBrushConverter.Instance}}"
                                     CaretBrush="#61AFEF"
                                     SelectionBrush="#3E4452"
                                     SelectionOpacity="0.65"
                                     FontSize="{Binding ReaderStyle.FontSize}"
                                     FontFamily="{Binding ReaderStyle.FontFamily}"
                                     FontWeight="{Binding ReaderStyle.FontWeight}"
                                     BorderThickness="0"
                                     Padding="0"
                                     Cursor="IBeam"
                                     SelectionChanged="OnFullArticleSelectionChanged"
                                     PreviewMouseLeftButtonUp="OnFullArticleMouseUp"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 视图 1：连贯自然段落沉浸阅读 (整段展示不生硬分行，段落内单词流式排版，点击任意句子即可高亮精读) -->
                <ListBox ItemsSource="{Binding Paragraphs}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         Visibility="{Binding LayoutMode, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=ContinuousParagraph}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="28,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 连贯自然段落卡片 (响应 ReaderStyle 自定义) -->
                            <Border Padding="20,16" 
                                    Background="{Binding DataContext.ReaderStyle.PageBackground, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <!-- 英文段落：按句子组合流式排版，不单句换行！ -->
                                    <ItemsControl ItemsSource="{Binding Sentences}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 单个句子：点击即可选中进行长难句精读分析 -->
                                                <Border Margin="0,0,6,4" Padding="2,2" CornerRadius="4" Cursor="Hand"
                                                        MouseLeftButtonDown="OnSentenceClick"
                                                        ToolTip="点击此句在右侧进行长难句学术精读分析">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#252A36" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <!-- 句子内的单词流式高亮 -->
                                                    <ItemsControl ItemsSource="{Binding Tokens}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding RawText}" 
                                                                           FontSize="{Binding DataContext.ReaderStyle.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           FontFamily="{Binding DataContext.ReaderStyle.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           FontWeight="{Binding DataContext.ReaderStyle.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           LineHeight="26">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{Binding DataContext.ReaderStyle.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:HexToBrushConverter.Instance}}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasExamHighlight}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{Binding DictInfo.ColorHex}" />
                                                                                    <Setter Property="FontWeight" Value="Medium" />
                                                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                                                    <Setter Property="Cursor" Value="Help" />
                                                                                    <Setter Property="ToolTip">
                                                                                        <Setter.Value>
                                                                                            <Border Background="#1E2025" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="320">
                                                                                                <StackPanel>
                                                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                                        <TextBlock Text="{Binding DictInfo.Word}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                                                                                        <TextBlock Text="{Binding DictInfo.Phonetic, StringFormat=' [{0}]'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,2,0,0" FontSize="12"/>
                                                                                                        <Border Background="#2C2F36" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                                                                            <TextBlock Text="{Binding DictInfo.PrimaryLevelName}" FontSize="10.5" Foreground="{Binding DictInfo.ColorHex}" FontWeight="Bold"/>
                                                                                                        </Border>
                                                                                                    </StackPanel>
                                                                                                    <TextBlock Text="{Binding DictInfo.DisplayTranslation}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#D1D5DB" FontSize="13" LineHeight="19"/>
                                                                                                    <Button Content="★ 收藏至生词本" Padding="8,4" FontSize="11" HorizontalAlignment="Right"
                                                                                                            Command="{Binding DataContext.AddWordToNotebookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                            CommandParameter="{Binding}" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 段落参考译文（若已翻译，显示在段落下部，支持优雅收缩） -->
                                    <Border Margin="0,10,0,0" Padding="10,8" Background="#16181D" CornerRadius="5"
                                            Visibility="{Binding FullChineseTranslation, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding FullChineseTranslation}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="13.5" LineHeight="23" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 视图 2：逐句对照卡片模式 (方便习惯单句对照精读的用户) -->
                <ListBox ItemsSource="{Binding FlatSentences}" SelectedItem="{Binding SelectedSentence}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         Visibility="{Binding LayoutMode, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=SentenceBySentence}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="28,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,14" 
                                    Background="{Binding DataContext.ReaderStyle.PageBackground, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:HexToBrushConverter.Instance}}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                    MouseLeftButtonDown="OnSentenceClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 英文原句 -->
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Tokens}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RawText}" 
                                                           FontSize="{Binding DataContext.ReaderStyle.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontFamily="{Binding DataContext.ReaderStyle.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="{Binding DataContext.ReaderStyle.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           LineHeight="26">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ReaderStyle.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:HexToBrushConverter.Instance}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasExamHighlight}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding DictInfo.ColorHex}" />
                                                                    <Setter Property="FontWeight" Value="Medium" />
                                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                                    <Setter Property="Cursor" Value="Help" />
                                                                    <Setter Property="ToolTip">
                                                                        <Setter.Value>
                                                                            <Border Background="#1E2025" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="320">
                                                                                <StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                        <TextBlock Text="{Binding DictInfo.Word}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                                                                        <TextBlock Text="{Binding DictInfo.Phonetic, StringFormat=' [{0}]'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,2,0,0" FontSize="12"/>
                                                                                        <Border Background="#2C2F36" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                                                            <TextBlock Text="{Binding DictInfo.PrimaryLevelName}" FontSize="10.5" Foreground="{Binding DictInfo.ColorHex}" FontWeight="Bold"/>
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding DictInfo.DisplayTranslation}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#D1D5DB" FontSize="13" LineHeight="19"/>
                                                                                    <Button Content="★ 收藏至生词本" Padding="8,4" FontSize="11" HorizontalAlignment="Right"
                                                                                            Command="{Binding DataContext.AddWordToNotebookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 右侧参考译文 -->
                                    <TextBlock Grid.Column="2" Text="{Binding ChineseTranslation}" 
                                               FontSize="{Binding DataContext.ReaderStyle.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontFamily="{Binding DataContext.ReaderStyle.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="25" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 细致分割线 -->
            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <!-- 右侧：长难句结构解析侧边栏 (极简学术面板) -->
            <Border Grid.Column="3" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="长难句学术精读" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- 当前选句/拖选卡片 -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="当前句子 / 选中文本" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedSentence.EnglishSentence, FallbackValue='(拖选文本或点击句子自动翻译与拆解)'}" 
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" LineHeight="21" FontWeight="Medium" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⚡ 重新精读分析" Command="{Binding AnalyzeCurrentSentenceCommand}" 
                                            Background="#2D3748" HorizontalAlignment="Left" Padding="14,6" FontSize="12"
                                            IsEnabled="{Binding IsBusy, Converter={x:Static local:BooleanToInverseBooleanConverter.Instance}}" />
                                    <TextBlock Text="正在分析..." Foreground="#61AFEF" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               Visibility="{Binding IsBusy, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 中文参考译文卡片 (醒目独立卡片，选择后自动呈现) -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding CurrentTranslation, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="中文参考译文" FontWeight="SemiBold" Foreground="#61AFEF" FontSize="13"/>
                                    <Border Background="#1E2A3A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="AI 智能翻译" FontSize="10" Foreground="#81A1C1"/>
                                    </Border>
                                </StackPanel>
                                <Border Background="#161C24" BorderBrush="#26384C" BorderThickness="1" CornerRadius="4" Padding="12,9">
                                    <TextBlock Text="{Binding CurrentTranslation}" Foreground="#ECEEF2" FontSize="13.5" LineHeight="22" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 主干结构拆解卡片 (带彩色背景区分主谓宾修饰成分，支持直接点击查词) -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="核心主干结构 (S-V-O-M)" FontWeight="SemiBold" Foreground="#81A1C1" Margin="0,0,0,10" FontSize="13"/>
                                
                                <!-- 主语 (S) - 典雅蓝灰色背景 -->
                                <Border Background="#1A2736" BorderBrush="#2D435E" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8"
                                        Visibility="{Binding CurrentAnalysis.Core.Subject, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="主语 (Subject)" Foreground="#61AFEF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentAnalysis.Core.Subject}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Cursor="Hand"
                                                   ToolTip="点击此片段单词可查询词典释义"
                                                   PreviewMouseLeftButtonUp="OnAnalysisSnippetMouseUp"/>
                                    </StackPanel>
                                </Border>

                                <!-- 谓语 (V) - 浅赤金黄背景 -->
                                <Border Background="#2B2416" BorderBrush="#59461F" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8"
                                        Visibility="{Binding CurrentAnalysis.Core.Predicate, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="谓语动词 (Predicate)" Foreground="#E5C07B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentAnalysis.Core.Predicate}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Cursor="Hand"
                                                   ToolTip="点击此片段单词可查询词典释义"
                                                   PreviewMouseLeftButtonUp="OnAnalysisSnippetMouseUp"/>
                                    </StackPanel>
                                </Border>

                                <!-- 宾语/表语 (O/C) - 翡翠翠绿背景 -->
                                <Border Background="#162720" BorderBrush="#244E3D" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8"
                                        Visibility="{Binding CurrentAnalysis.Core.ObjectOrComplement, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="宾语 / 表语 / 补足语 (Object / Complement)" Foreground="#98C379" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentAnalysis.Core.ObjectOrComplement}" Foreground="#ECEEF2" FontSize="13" TextWrapping="Wrap" Cursor="Hand"
                                                   ToolTip="点击此片段单词可查询词典释义"
                                                   PreviewMouseLeftButtonUp="OnAnalysisSnippetMouseUp"/>
                                    </StackPanel>
                                </Border>

                                <!-- 状语/引导/前置修饰 (Adv/Mod) - 紫粉色背景 -->
                                <Border Background="#261A29" BorderBrush="#4E2B56" BorderThickness="1" CornerRadius="4" Padding="10,7"
                                        Visibility="{Binding CurrentAnalysis.Core.AdverbialOrModifier, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="状语 / 引导修饰 (Modifier / Adverbial)" Foreground="#C678DD" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentAnalysis.Core.AdverbialOrModifier}" Foreground="#ECEEF2" FontSize="13" TextWrapping="Wrap" Cursor="Hand"
                                                   ToolTip="点击此片段单词可查询词典释义"
                                                   PreviewMouseLeftButtonUp="OnAnalysisSnippetMouseUp"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 从句与语法特征 (带柔和琥珀/洋红背景卡片) -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="从句与语法特征" FontWeight="SemiBold" Foreground="#8FBCBB" Margin="0,0,0,10" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding CurrentAnalysis.Clauses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#201C24" BorderBrush="#403248" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="#E06C75" FontSize="12.5" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ClauseContent}" FontStyle="Italic" Foreground="#D19A66" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" Cursor="Hand"
                                                               ToolTip="点击从句文本中单词查词"
                                                               PreviewMouseLeftButtonUp="OnAnalysisSnippetMouseUp"/>
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="18"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 考点精讲与解题陷阱 (带暗蓝底色) -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding CurrentAnalysis.ExamFocusNotes.Count, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <TextBlock Text="真题考点与理解陷阱" FontWeight="SemiBold" Foreground="#56B6C2" Margin="0,0,0,8" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding CurrentAnalysis.ExamFocusNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#172228" BorderBrush="#253A44" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 重点词汇与同义替换 (可直接点击一键查词与收藏) -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="重点词汇与同义替换 (点击查词)" FontWeight="SemiBold" Foreground="#BF616A" Margin="0,0,0,8" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding CurrentAnalysis.KeyVocabularies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1C1E24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6" Cursor="Hand"
                                                    MouseLeftButtonDown="OnVocabSnippetClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding Word}" FontWeight="Bold" Foreground="#61AFEF" FontSize="13" Margin="0,0,8,0"/>
                                                            <Border Background="#2C2F36" CornerRadius="3" Padding="5,1">
                                                                <TextBlock Text="{Binding ExamLevel}" FontSize="10.5" Foreground="#E5C07B" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SynonymSubstitutions, Converter={x:Static local:ListJoinConverter.Instance}, StringFormat='同义替换: {0}'}" 
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="🔍 查释义" Padding="7,3" FontSize="11" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.LookupWordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Word}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 单点词汇即时查询结果浮窗卡片 (当在右侧点击查词时展开展示) -->
                        <Border Background="#1A1C22" BorderBrush="#3B4252" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10"
                                Visibility="{Binding QuickLookupResult, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="📖 词汇即时释义" FontWeight="SemiBold" Foreground="#98C379" FontSize="12.5"/>
                                    <Border Background="#252A34" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding QuickLookupResult.PrimaryLevelName}" FontSize="10.5" Foreground="{Binding QuickLookupResult.ColorHex}" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding QuickLookupResult.Word}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding QuickLookupResult.Phonetic, StringFormat=' [{0}]'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,2,0,0" FontSize="12.5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding QuickLookupResult.DisplayTranslation}" TextWrapping="Wrap" Foreground="#D1D5DB" FontSize="13" LineHeight="20" Margin="0,4,0,10"/>
                                <Button Content="★ 收藏到生词本" HorizontalAlignment="Left" Padding="10,4" FontSize="11.5"
                                        Command="{Binding AddQuickLookupToNotebookCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部轻量状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel>
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="90" Height="6" Margin="16,0,0,0"
                             DockPanel.Dock="Right" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
