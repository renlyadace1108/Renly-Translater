<Window x:Class="ExamBilingualReader.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamBilingualReader.Wpf.Views"
        Title="ExamBilingualReader - 四六级与雅思双语对照精读系统" Height="800" Width="1300"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏与专区切换 -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="15,0">
                <!-- 左侧软件标题与专区选项卡 (Tab) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 品牌 Logo 图标 -->
                    <Border CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="ExamBilingualReader" FontSize="16" FontWeight="Bold" Margin="0,0,25,0" VerticalAlignment="Center"/>

                    <!-- 专区切换按钮组 -->
                    <Border Background="#1E1E24" CornerRadius="6" Padding="3" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content=" 🎓 四六级真题备考区 " GroupName="ZoneGroup" IsChecked="True"
                                         Click="OnExamZoneClick"
                                         Style="{StaticResource {x:Type ToggleButton}}" Background="#2563EB" Foreground="White"
                                         Padding="12,5" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            <RadioButton Content=" 📰 英语文章 / 学术外刊区 " GroupName="ZoneGroup"
                                         Click="OnGeneralArticleZoneClick"
                                         Style="{StaticResource {x:Type ToggleButton}}" Background="#374151" Foreground="White"
                                         Padding="12,5" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <Button Content="📁 导入本地文章/PDF" Click="OnImportArticleClick" Margin="0,0,8,0" Background="#EA580C"/>
                    <Button Content="⚡ 一键全篇翻译" Command="{Binding TranslateAllSentencesCommand}" Background="#7C3AED" Margin="0,0,8,0"/>
                    <Button Content="★ 生词本" Click="OnOpenNotebookClick" Background="#059669" Margin="0,0,8,0"/>
                    <Button Content="⚙ 模型配置 (BYOK)" Click="OnOpenSettingsClick" Background="#374151"/>
                </StackPanel>
                
                <!-- 考纲图例指示 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="词库考纲图例：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#66BB6A" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"><TextBlock Text="四级 CET-4" Foreground="White" FontSize="11"/></Border>
                    <Border Background="#FBC02D" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"><TextBlock Text="六级 CET-6" Foreground="Black" FontSize="11" FontWeight="SemiBold"/></Border>
                    <Border Background="#FF7043" CornerRadius="3" Padding="6,2"><TextBlock Text="雅思/学术" Foreground="White" FontSize="11"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容区域：[真题导航抽屉] + [双栏精读区] + [长难句解析侧边栏] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 四六级真题备考专用导航栏 (在文章模式下可折叠) -->
                <ColumnDefinition Width="Auto" />
                <!-- 双语对照阅读主视区 -->
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <!-- 右侧长难句解析与考点拆解栏 -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 四六级备考专区：真题快速选择面板 -->
            <Border Grid.Column="0" Width="260" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding CurrentZone, Converter={x:Static local:EnumEqualsToVisibilityConverter.Instance}, ConverterParameter=ExamPreparation}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="历年真题库 (GitHub实时)" FontWeight="Bold" FontSize="14" Foreground="#60A5FA" Margin="0,0,0,8"/>

                    <!-- 分类筛选器 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="全部" Command="{Binding FilterExamCategoryCommand}" CommandParameter="ALL" Padding="8,3" FontSize="11" Margin="0,0,4,0"/>
                        <Button Content="CET-4 四级" Command="{Binding FilterExamCategoryCommand}" CommandParameter="CET4" Padding="8,3" FontSize="11" Margin="0,0,4,0" Background="#16A34A"/>
                        <Button Content="CET-6 六级" Command="{Binding FilterExamCategoryCommand}" CommandParameter="CET6" Padding="8,3" FontSize="11" Background="#CA8A04"/>
                    </StackPanel>

                    <!-- 真题列表 -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding ExamPapers}" SelectedItem="{Binding SelectedExamPaper}"
                             Background="#09090B" BorderBrush="#27272A"
                             SelectionChanged="OnExamPaperSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,6" Margin="0,2" Background="#18181B" CornerRadius="4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#2563EB" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding YearMonth}" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 双语对照阅读区 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Paragraphs}" Margin="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,20" Padding="15" Background="{StaticResource CardBackgroundBrush}" CornerRadius="6">
                                <ItemsControl ItemsSource="{Binding Sentences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#3F3F46" Cursor="Hand"
                                                    MouseLeftButtonDown="OnSentenceClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 英文原句（流式词汇高亮 + Tooltip 悬浮卡片） -->
                                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Tokens}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding RawText}" FontSize="15" LineHeight="24">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="White" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasExamHighlight}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{Binding DictInfo.ColorHex}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                                                    <Setter Property="Cursor" Value="Help" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <!-- 悬浮词典 Card -->
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip IsOpen="False" Visibility="{Binding HasExamHighlight, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                                                            <Border Background="#1F2937" CornerRadius="6" Padding="10" MaxWidth="320">
                                                                                <StackPanel>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="{Binding DictInfo.Word}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                                                                        <TextBlock Text="{Binding DictInfo.Phonetic, StringFormat=' [{0}]'}" Foreground="#9CA3AF" Margin="6,2,0,0"/>
                                                                                        <Border Background="{Binding DictInfo.ColorHex}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                                                                            <TextBlock Text="{Binding DictInfo.PrimaryLevelName}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding DictInfo.DisplayTranslation}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#E5E7EB" FontSize="13"/>
                                                                                    <Button Content="★ 收藏至生词本" Margin="0,8,0,0" Padding="6,3" FontSize="11" Background="#3B82F6"
                                                                                            Command="{Binding DataContext.AddWordToNotebookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </ToolTip>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 右侧参考译文 -->
                                                    <TextBlock Grid.Column="2" Text="{Binding ChineseTranslation}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="#27272A"/>

            <!-- 右侧：长难句结构解析侧边栏 -->
            <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="长难句学术精读分析" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Border Background="#1E1E24" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="当前选中句子：" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedSentence.EnglishSentence, FallbackValue='(请点击左侧任意句子开始精读)'}" 
                                           TextWrapping="Wrap" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- 主干结构拆解 -->
                        <Border Background="#1E1E24" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="主干结构 (主-谓-宾/表)" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CurrentAnalysis.Core.Subject, StringFormat='主语: {0}'}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentAnalysis.Core.Predicate, StringFormat='谓语: {0}'}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentAnalysis.Core.ObjectOrComplement, StringFormat='宾语/表语: {0}'}"/>
                            </StackPanel>
                        </Border>

                        <!-- 从句分析 -->
                        <Border Background="#1E1E24" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="从句与语法特征" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding CurrentAnalysis.Clauses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="0,4,0,6" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                    <TextBlock Text="{Binding ClauseContent}" FontStyle="Italic" Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,2"/>
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 考点与同义替换词 -->
                        <Border Background="#1E1E24" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="考点与高频同义替换" FontWeight="Bold" Foreground="#F43F5E" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding CurrentAnalysis.KeyVocabularies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Word}" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding SynonymSubstitutions, Converter={x:Static local:ListJoinConverter.Instance}, StringFormat='(替换: {0})'}" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,0">
            <DockPanel>
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="10" Margin="15,0,0,0"
                             DockPanel.Dock="Right" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
