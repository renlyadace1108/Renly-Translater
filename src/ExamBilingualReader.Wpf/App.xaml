<Application x:Class="ExamBilingualReader.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExamBilingualReader.Wpf">
    <Application.Resources>
        <!-- 基础色彩与现代无衬线字体风格 -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E24" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A32" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
